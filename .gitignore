# ============================================================
# .gitignore for pst-voiceover-engine
# ============================================================

# ------------------------------------------------------------
# Output & Generated Files
# ------------------------------------------------------------
extracted-pst/
voices_prep_pst/
# Revoice work: audio is output (ignored); the work that went into it is tracked
pst_revoice/*
!pst_revoice/directions.json
!pst_revoice/directions_claude.json
!pst_revoice/moods.csv
!pst_revoice/plan.csv
!pst_revoice/plan_meta.json
!pst_revoice/floats.csv
!pst_revoice/infopoints.csv
!pst_revoice/test_lines.txt
!pst_revoice/sample_listen.json
!pst_revoice/original/
!pst_revoice/audio_fish/
pst_revoice/audio_fish/*
!pst_revoice/audio_fish/generation.json
mod-pst-revoice/
.cache/

# ------------------------------------------------------------
# Profile & Configuration Data
# ------------------------------------------------------------

# ------------------------------------------------------------
# WeiDU Modding Tool Files
# ------------------------------------------------------------
# WeiDU mod files
weidu/*.tp2         
# WeiDU exported content
weidu/export/        

# ------------------------------------------------------------
# Global congif, Logs & Temporary Files
# ------------------------------------------------------------
# App config
appconfig.json
# All log files
*.log                
# Backup files
*.bak                

# ------------------------------------------------------------
# Generated Data Files
# ------------------------------------------------------------
# String reference mappings
strrefs*.json                

# ------------------------------------------------------------
# Development Helper Scripts
# ------------------------------------------------------------

# ------------------------------------------------------------
# Python Cache & Virtual Environment
# ------------------------------------------------------------
# Python bytecode cache
__pycache__/         
# Compiled Python files
*.pyc                
# Virtual environment
.venv/               
venv/                
# Package metadata
*.egg-info/          
# Build folders
dist/                
build/         
# PyTest cache (explicitly)
.pytest_cache/   

# ------------------------------------------------------------
# IDE & OS Specific
# ------------------------------------------------------------
# VS Code settings
.vscode/             
# Claude AI settings
.claude/
# PyCharm/IntelliJ settings
.idea/               
# Vim swap files
*.swp                
# MacOS folder metadata
.DS_Store            
# Windows thumbnail cache
Thumbs.db           
CLAUDE.local.md

*.wav
*.WAV
*.mp3
*.ogg
*.mp3
voice_library/*
voices_pst/*
extracted-pst-classic/
voices_drama3_pst/
voices_prep_pst-classic/
voices_moods_pst/
pst_moods/
pst_revoice/*
nwn-path.txt

